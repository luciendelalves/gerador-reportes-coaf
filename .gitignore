# ==========================================
# GitIgnore - Gerador COAF (PLD/FT)
# ==========================================

# Ambientes virtuais e cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
.pytest_cache/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Streamlit
.streamlit/

# ==========================================
# SEGURANÇA: Chaves de API e Tokens OAuth
# ==========================================
oauth_client.json
token_google.json

# ==========================================
# LGPD & SIGILO BANCÁRIO / PLD-FT
# ==========================================
# Arquivos contendo dados de apostadores (CPF, nome, valores transacionados)
historico_casos.json
lote_casos.json
arquivo_casos.json
lote_extraido.csv

# Relatórios mestres, bases mensais e PDFs de risco
*.docx
*.pdf
*.xlsx
*.xls
*.csv
*.pbix

# Diretório Power BI com bases de dados reais
Power BI/*.xlsx
Power BI/*.pdf
Power BI/*.pbix

# Arquivos temporários de sistema
Thumbs.db
desktop.ini
.DS_Store
*.tmp


# Instruções internas do assistente (contêm nomes e procedimentos internos)
CLAUDE.md
.claude/
publicar_github.py
